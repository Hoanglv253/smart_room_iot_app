rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(currentUserPath());
    }

    function currentUser() {
      return get(currentUserPath()).data;
    }

    function isAdmin() {
      return hasUserProfile() && currentUser().role == 'admin';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function buildingPath(buildingId) {
      return /databases/$(database)/documents/buildings/$(buildingId);
    }

    function isBuildingAdmin(buildingId) {
      return signedIn()
        && exists(buildingPath(buildingId))
        && get(buildingPath(buildingId)).data.adminId == request.auth.uid;
    }

    function isBuildingMember(buildingId) {
      return hasUserProfile() && currentUser().buildingId == buildingId;
    }

    function isBuildingManager(buildingId) {
      return isBuildingMember(buildingId) && currentUser().role == 'manager';
    }

    function canManageBuildingNotifications(buildingId) {
      return isBuildingAdmin(buildingId) || isBuildingManager(buildingId);
    }

    function canReadBuildingNotification(notification) {
      return signedIn()
        && (
          isBuildingAdmin(notification.buildingId)
          || isBuildingManager(notification.buildingId)
          || isBuildingMember(notification.buildingId)
        );
    }

    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /buildingPayosSettings/{buildingId} {
      allow read, write: if false;
    }

    match /buildings/{buildingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.adminId == request.auth.uid;

      match /rooms/{roomId} {
        allow read: if signedIn();
        allow create, update, delete: if isBuildingAdmin(buildingId);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }

      match /invoices/{invoiceId} {
        allow read: if signedIn();
        allow create, delete: if isBuildingAdmin(buildingId);
        allow update: if isBuildingAdmin(buildingId)
          || (
            signedIn()
            && resource.data.tenantId == request.auth.uid
            && resource.data.status == 'unpaid'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'paymentMethod',
                'paymentNote',
                'paidReportedAt',
                'updatedAt'
              ])
          );
      }
    }

    match /joinRequests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.adminId == request.auth.uid
          || isBuildingAdmin(resource.data.buildingId)
        );
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.adminId == request.auth.uid
          || isBuildingAdmin(resource.data.buildingId)
        );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if canReadBuildingNotification(resource.data);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && canManageBuildingNotifications(request.resource.data.buildingId);
      allow update: if canReadBuildingNotification(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readBy', 'updatedAt']);
      allow delete: if canManageBuildingNotifications(resource.data.buildingId);
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
